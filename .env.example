NODE_ENV=development
PORT=4003
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Shared local stack (ecommerce-infrastructure: docker compose up -d):
DATABASE_URL=postgresql://inventory_svc:inventory_local_pw@localhost:5432/inventory_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://inventory_svc:inventory_local_pw@localhost:5443/inventory_db
# Integration tests create and drop this database:
TEST_DATABASE_URL=postgresql://inventory_svc:inventory_local_pw@localhost:5432/inventory_test
DB_POOL_SIZE=10

JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-inventory-service

RESERVATION_DEFAULT_TTL_SECONDS=2700
EXPIRY_SWEEP_INTERVAL_MS=30000
